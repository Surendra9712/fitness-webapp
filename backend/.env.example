DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Password
DB_NAME=smartdiet_fitness
JWT_SECRET=change-this-to-a-long-random-secret-key
FLASK_PORT=5000

# dev | production — dev enables testing-only behavior, e.g. simulated
# sequential-day advancement for End Meal Today (see backend/utils/devtime.py)
MODE=production

# Payment gateways (sandbox/test credentials)
FRONTEND_URL=https://localhost:5175

ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Stripe — there is no shared public test key; each developer needs their own
# free Stripe account. Get a test secret key (starts with sk_test_) from
# https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=test_stripe_key
STRIPE_CURRENCY=usd
# NPR->USD conversion used only for Stripe charges (app prices stay in NPR everywhere else).
# Live rate is fetched from Nepal Rastra Bank's public forex API (nrb.org.np) and cached for
# 6 hours; NPR_TO_USD_FALLBACK_RATE is only used if that API is unreachable.
NPR_TO_USD_FALLBACK_RATE=133
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=test_stripe_publish_key
# ExerciseDB (RapidAPI) — get a free-tier key at https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# Leave empty to fall back to wger.de (static images, no key required).
EXERCISEDB_API_KEY=89fd1470a9msh9938916ed1f1859p15fe52jsn30dz


# dev | production — dev enables testing-only behavior, e.g. simulated
# sequential-day advancement for End Meal Today (see backend/utils/devtime.py)
MODE=dev
