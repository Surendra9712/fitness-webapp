DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Password
DB_NAME=smartdiet_fitness
JWT_SECRET=change-this-to-a-long-random-secret-key
FLASK_PORT=5000

# Payment gateways (sandbox/test credentials)
FRONTEND_URL=https://localhost:5175

ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Stripe — there is no shared public test key; each developer needs their own
# free Stripe account. Get a test secret key (starts with sk_test_) from
# https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=test_stripe_key
STRIPE_CURRENCY=usd
# NPR->USD conversion used only for Stripe charges (app prices stay in NPR everywhere else).
# Live rate is fetched from Nepal Rastra Bank's public forex API (nrb.org.np) and cached for
# 6 hours; NPR_TO_USD_FALLBACK_RATE is only used if that API is unreachable.
NPR_TO_USD_FALLBACK_RATE=133
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=test_stripe_publish_key
# ExerciseDB (RapidAPI) — get a free-tier key at https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# Leave empty to fall back to wger.de (static images, no key required).
EXERCISEDB_API_KEY=89fd1470a9msh9938916ed1f1859p15fe52jsn30dz


# dev | production — dev enables testing-only behavior, e.g. simulated
# sequential-day advancement for End Meal Today (see backend/utils/devtime.py)
MODE=dev

# SMTP — used for password-reset emails. Optional: with SMTP_HOST empty the
# reset link is printed to the server log instead, and in MODE=dev the
# /api/auth/forgot-password response also carries it as `dev_reset_url`.
#
# Mailtrap Email Sandbox — recommended for development. Every message is
# trapped in your Mailtrap inbox instead of reaching the real recipient, so
# testing a reset against a seeded user's address is safe. Copy the credentials
# from Mailtrap → Email Testing → Inboxes → your inbox → Integrations → SMTP:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<inbox username>
#   SMTP_PASSWORD=<inbox password>
#   SMTP_FROM=SmartDiet Pro <no-reply@smartdiet.test>
#
# Mailtrap Email Sending — for real delivery once a sending domain is verified.
# The username is the literal string "api"; the password is your API token, and
# SMTP_FROM must be on the verified domain:
#   SMTP_HOST=live.smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_USER=api
#   SMTP_PASSWORD=<api token>
#   SMTP_FROM=SmartDiet Pro <no-reply@your-verified-domain.com>
#
# Gmail (needs an App Password, not the account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM=SmartDiet Pro <you@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
