# API base URL used by axios instances (relative "/api" relies on the Vite dev proxy / same-origin prod deploy)
VITE_API_BASE_URL=/api

# dev | production — dev enables testing-only UI behavior (e.g. always-enabled
# "End Meal Today" for simulating consecutive days). Must match backend MODE.
VITE_MODE=production

# Branding
VITE_APP_NAME=SmartDiet
VITE_APP_LOGO=/smart-diet-pro-dark.svg
VITE_APP_LOGO_LIGHT=/smart-diet-pro-light.svg
VITE_PRO_PLAN_FEE=200
